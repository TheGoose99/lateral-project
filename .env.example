APP_ENV=development
APP_NAME=Takeaway Platform API
API_PREFIX=/api/v1
SECRET_KEY=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql+psycopg://takeaway:takeaway_dev_password@db:5432/takeaway
POSTGRES_DB=takeaway
POSTGRES_USER=takeaway
POSTGRES_PASSWORD=takeaway_dev_password
FRONTEND_ORIGIN=http://localhost:8080
REDIS_URL=redis://redis:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
ORDER_RATE_LIMIT_PER_MINUTE=20
